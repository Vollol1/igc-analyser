# ── Environment / credentials ───────────────────────────────────────────────
# .env enthält echte Credentials und darf NIEMALS committet werden.
# Siehe docs/decisions/ADR-001-architecture-techstack.md und
# /home/florian/github.com/Vollol1/gag-atlas/docs/decisions/ADR-007-secrets-management.md
.env
.env.local
.env.*.local

# ── Python virtual environments ─────────────────────────────────────────────
.venv/
venv/
env/

# ── Python bytecode / caches ────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ── SQLite databases ────────────────────────────────────────────────────────
*.db
*.db-journal
*.sqlite
*.sqlite3

# ── Downloaded IGC files (generated runtime artifacts) ──────────────────────
data/igc/
!data/igc/.gitkeep

# ── Processed outputs (generated by scripts) ────────────────────────────────
data/processed/*.jsonl
data/processed/*.json
data/processed/*.csv

# Keep the directory itself
!data/processed/.gitkeep

# ── Web/export outputs (generated by scripts) ─────────────────────────────────
data/export/*.json

# Keep the directory itself
!data/export/.gitkeep

# ── Logs (local runtime artifacts) ────────────────────────────────────────────
data/logs/*.log
data/logs/*.json
data/logs/*.out
data/logs/*.pid
!data/logs/.gitkeep

# ── IDE / editor ──────────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*~

# ── OS generated ──────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
