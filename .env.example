# igc-extractor – Example environment configuration
# Copy this file to .env and fill in your real credentials.
# NEVER commit .env; it contains secrets.

# ── Precedence ───────────────────────────────────────────────────────────────
# Configuration values are resolved in the following order (highest first):
#
#   1. Explicit CLI arguments (e.g. --username, --rate-limit)
#   2. Environment variables exported in the current shell
#   3. Variables defined in a local `.env` file (loaded by python-dotenv)
#
# This means: CLI args > env > .env > built-in defaults.
# Uncomment and fill only the values you want to change from the defaults.

# ── Required secrets ─────────────────────────────────────────────────────────
# Your personal credentials for the supported flight-data platform.
# Leave the placeholders empty/commented here and put real values into `.env`.
DHV_XC_USERNAME=
DHV_XC_PASSWORD=

# ── Optional DHV-XC / platform settings ──────────────────────────────────────
# Pilot/sender name used in export outputs (README.txt, PDF cover sheet,
# map statistics panel). This is safe to commit as an example default.
PILOT_NAME=Max Mustermann

# Base URL of the flight-data platform. Only change if the platform moves.
# DHV_XC_BASE_URL=https://www.dhv-xc.de

# Optional numeric pilot ID. Usually detected automatically; only set this if
# you need to override the detected/implicit ID.
# DHV_XC_PILOT_ID=12345

# ── Optional path overrides ──────────────────────────────────────────────────
# All paths are relative to the project root by default. Uncomment and change
# only if you want to store data or outputs outside the repository.
# IGC_DIR=data/igc
# FLIGHTS_JSONL=data/processed/flights.jsonl
# DB_PATH=data/igc-extractor.db
# OUTPUT_DIR=data/export

# ── Optional tuning ──────────────────────────────────────────────────────────
# Seconds to wait between consecutive IGC downloads.
# RATE_LIMIT=1.0

# Maximum download attempts per IGC file before giving up.
# MAX_RETRIES=3
