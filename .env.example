# igc-extractor – Example environment configuration
# Copy this file to .env and fill in your real credentials.
# NEVER commit .env; it contains secrets.
# See docs/decisions/ADR-001-architecture-techstack.md and
# docs/decisions/ADR-007-secrets-management.md (or the public mirror at
# https://github.com/Vollol1/gag-atlas/blob/main/docs/decisions/ADR-007-secrets-management.md).

DHV_XC_USERNAME=your_dhv_xc_username
DHV_XC_PASSWORD=your_dhv_xc_password

# Optional: pilot/sender name used for README.txt (export_igc_zip.py) and
# the map panel (export_flight_map.py). If unset, a generic placeholder is used.
PILOT_NAME=""

# Optional overrides
# DHV_XC_BASE_URL=https://www.dhv-xc.de
# DHV_XC_PILOT_ID=12345
